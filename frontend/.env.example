# Leave VITE_API_BASE_URL empty to run without a backend (notebook snapshot + demo layers).
# Set it to enable live mode, e.g. "/api" (with the dev proxy below) or "http://localhost:8000/api".
VITE_API_BASE_URL=

# Optional: dev-server proxy target for /api/* requests.
VITE_API_PROXY_TARGET=http://localhost:8000
